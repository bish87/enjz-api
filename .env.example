# Copy this file to .env and fill in real values.

DATABASE_URL="postgresql://user:password@localhost:5432/enjz?schema=public"
# Minimum 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=""
NODE_ENV="development"
PORT=3000
# Comma-separated list of allowed browser origins
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Used by prisma/seed.js to create/refresh the admin account
ADMIN_PHONE="+249900000000"
ADMIN_PASSWORD=""
ADMIN_EMAIL="admin@enjz.local"

# Optional: overrides the test database used by `npm test`
# TEST_DATABASE_URL="postgresql://user:password@localhost:5432/enjz_test?schema=public"
