# Copy this file to .env and fill in real values.

NODE_ENV="development"
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL="info"

DATABASE_URL="postgresql://user:password@localhost:5432/enjz?schema=public"
# Minimum 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=""
# bcrypt cost factor. 10 is a good default; tests use 4.
BCRYPT_ROUNDS=10

# Comma-separated list of allowed browser origins (no wildcards in production).
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
# Used to build password reset links.
FRONTEND_URL="http://localhost:5173"

# Optional email delivery for password resets (Resend free tier).
# When either value is missing, reset emails are skipped and a warning is logged.
RESEND_API_KEY=""
FROM_EMAIL=""

# Used by prisma/seed.js to create/refresh the admin account.
# `npm run db:seed` requires ADMIN_PHONE and ADMIN_PASSWORD; ADMIN_EMAIL is optional.
ADMIN_PHONE="+249900000000"
ADMIN_PASSWORD=""
ADMIN_EMAIL="admin@enjz.local"

# Optional: overrides the test database used by `npm test`
# TEST_DATABASE_URL="postgresql://user:password@localhost:5432/enjz_test?schema=public"
